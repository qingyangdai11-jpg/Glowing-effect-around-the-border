# 这是一份标准的 Unity .gitignore 配置

# 引擎自动生成的缓存文件夹（绝对不能上传）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# 内存捕获（可能非常大且包含敏感数据）
/[Mm]emoryCaptures/

# Visual Studio 和各种编辑器的缓存目录
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 各种自动生成的无用 meta 和崩溃报告
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# 打包出来的安装文件（不需要传进代码库）
*.apk
*.aab
*.unitypackage
*.app
*.app.zip
shader/Assets/OutdoorsScene.unity.meta
